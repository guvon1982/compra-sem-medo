# Variaveis de ambiente do front (lidas pelo Vite).
# Copie este arquivo para `.env` e ajuste os valores conforme o ambiente.
# Apenas variaveis com prefixo VITE_ ficam disponiveis no codigo do navegador.

# URL base da API REST. Sem barra "/" no final.
# - Desenvolvimento: json-server local (valor abaixo).
# - Producao: aponte para a API real, ex.: https://api.seudominio.com
# Se nao definida, o codigo usa http://localhost:3000 como padrao.
VITE_API_URL=http://localhost:3000
